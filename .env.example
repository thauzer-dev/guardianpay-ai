# Copie para .env (fora do git). Nada aqui é obrigatório para rodar o núcleo.
GP_RAW_DIR=data/raw
GP_DB_PATH=var/guardianpay.db
GP_SIM_START=2026-11-02T08:00:00
GP_SIM_TICKS=168
# LLM opcional via AI Proxy (formato OpenAI). Sem token => modo determinístico.
AI_PROXY_BASE_URL=https://ai-proxy.gogroupbr.com/v1
# Modelo usado DIRETAMENTE (sem consultar /v1/models). Identificadores documentados no guia do AI Proxy (docs/AI_PROXY.md):
#   latest (recomendado pelo guia para apps), gpt-6-astra, gpt-6-sol, gpt-6-luna, gpt-5.6-terra, gpt-5.6-luna,
#   glm-5.3, glm-5.3-flash, mimo-v2.6-pro, mimo-v2.6-flash, k3.1-pro, kimi-for-coding   (deepseek-* é bloqueado)
# Vazio = tenta listar /v1/models; se a listagem for proibida (403), defina este valor.
AI_PROXY_MODEL=latest
AI_PROXY_MODEL_PREFERENCE=gpt-6-luna,glm-5.3-flash,mimo-v2.6-flash
# off = desliga o LLM mesmo com token
GP_LLM_MODE=auto
AI_PROXY_API_KEY=
# --- Runtime do LLM (limites por instância; valores fora da faixa são ajustados ao limite seguro) ---
# Timeout de leitura por chamada (máx. 120: o gateway corta rotas síncronas em ~125 s). Timeout NÃO é reenviado.
GP_LLM_TIMEOUT_S=90
GP_LLM_CONNECT_RETRIES=1
GP_LLM_MAX_TOKENS_CALL=2000
GP_LLM_MAX_CALLS_INSTANCE=60
GP_LLM_MAX_TOKENS_INSTANCE=150000
# fração do orçamento da instância que o agente autônomo (ciclos) pode usar; o resto é reservado à conversa
GP_LLM_AUTONOMOUS_SHARE=0.6
GP_LLM_MAX_CALLS_TASK=3
GP_LLM_MAX_TOKENS_TASK=24000
GP_LLM_TASK_DEADLINE_S=110
GP_LLM_MAX_CONCURRENCY=2
GP_LLM_MAX_CASES_PER_CYCLE=3
GP_LLM_MAX_SECONDS_PER_CYCLE=120
# disjuntor: N falhas transitórias seguidas abrem; erro permanente (401/403/modelo) abre na hora com cooldown maior
GP_LLM_BREAKER_THRESHOLD=2
GP_LLM_BREAKER_COOLDOWN_S=60
GP_LLM_BREAKER_PERMANENT_COOLDOWN_S=900
